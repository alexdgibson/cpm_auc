for(i in seq_along(pdf_urls)) {
if(!is.na(pdf_urls[i])) {
# Build the full path for the PDF
file_path <- file.path(out_dir, paste0(pdf_name[i], ".pdf"))
# Request with redirect handling + browser header
response <- GET(
pdf_urls[i],
user_agent("Mozilla/5.0"),
timeout(60),
config(followlocation = TRUE)
)
# Only save if it's actually a PDF
if (http_type(response) == "application/pdf") {
writeBin(content(response, "raw"), file_path)
message("Downloaded: ", pdf_name[i])
} else {
message("Not a PDF (likely HTML): ", pdf_urls[i])
}
Sys.sleep(1)  # polite pause
}
}
